# ===================================
# KeyDo 后端开发环境配置示例
# ===================================
# 
# 使用说明：
# 1. 复制此文件为 .env.development
# 2. 根据需要修改配置
# 3. 启动本地数据库（使用 docker-compose.yml）

# ===================================
# 数据库配置
# ===================================

# PostgreSQL 连接字符串（本地开发）
# 需要先启动本地数据库：cd server/keyDoServer && docker-compose up -d
DATABASE_URL="postgresql://keydo:keydo123@localhost:5433/keydo_db?schema=public"

# ===================================
# JWT 认证配置
# ===================================

# JWT 密钥（开发环境可以使用简单的密钥）
JWT_SECRET="dev-secret-key-for-development-only"

# JWT Token 过期时间（开发环境可以设置较长时间）
JWT_EXPIRES_IN="7d"

# ===================================
# 服务配置
# ===================================

# 服务监听端口
PORT=6040

# 运行环境
NODE_ENV=development

# ===================================
# CORS 跨域配置
# ===================================

# 允许访问的前端域名（开发环境允许所有本地端口）
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,http://localhost:5174"

# ===================================
# 日志配置
# ===================================

# 日志级别（开发环境使用 debug 查看详细日志）
LOG_LEVEL="debug"

# ===================================
# 开发环境注意事项
# ===================================
#
# 1. 确保已启动本地数据库：
#    cd server/keyDoServer && docker-compose up -d
#
# 2. 首次运行需要执行数据库迁移：
#    pnpm --filter keydo-server prisma:migrate
#
# 3. 生成 Prisma Client：
#    pnpm --filter keydo-server prisma:generate
#
# 4. 启动开发服务器：
#    pnpm --filter keydo-server dev
