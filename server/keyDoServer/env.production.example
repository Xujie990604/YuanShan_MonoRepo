# ===================================
# KeyDo 后端生产环境配置示例
# ===================================
# 
# 使用说明：
# 1. 复制此文件为 .env.production
# 2. 修改所有标记为 "必须修改" 的配置项
# 3. 确保不要将 .env.production 提交到 Git
#
# 注意：Docker Compose 部署时，大部分配置会在 docker-compose.yml 中覆盖
# 此文件主要用于非 Docker 部署或本地测试

# ===================================
# 数据库配置
# ===================================

# PostgreSQL 连接字符串
# 格式：postgresql://用户名:密码@主机:端口/数据库名?schema=public
# Docker 部署时使用容器名: postgres:5432
# 本地部署时使用: localhost:5432
DATABASE_URL="postgresql://keydo:keydo123@localhost:5432/keydo_db?schema=public"

# ===================================
# JWT 认证配置
# ===================================

# JWT 密钥（⚠️ 生产环境必须修改为强随机字符串）
# 建议使用 32 位以上的随机字符串
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-production-secret-key-please-change-this-to-random-string"

# JWT Token 过期时间
# 格式：数字+单位（s=秒, m=分钟, h=小时, d=天）
# 示例：7d=7天, 24h=24小时, 30m=30分钟
JWT_EXPIRES_IN="7d"

# ===================================
# 服务配置
# ===================================

# 服务监听端口
PORT=6040

# 运行环境（development | production | test）
NODE_ENV=production

# ===================================
# CORS 跨域配置
# ===================================

# 允许访问的前端域名（多个域名用逗号分隔）
# 开发环境示例：http://localhost:3000,http://localhost:5173
# 生产环境示例：https://yourdomain.com,https://www.yourdomain.com
# 使用 * 允许所有域名（⚠️ 生产环境不推荐）
CORS_ORIGIN="https://yourdomain.com,https://www.yourdomain.com"

# ===================================
# 日志配置（可选）
# ===================================

# 日志级别（error | warn | info | debug | verbose）
# 生产环境建议使用 info 或 warn
LOG_LEVEL="info"

# ===================================
# 其他配置（可选）
# ===================================

# API 请求速率限制（每分钟最大请求数）
# RATE_LIMIT=100

# Session 密钥（如果使用 session）
# SESSION_SECRET="your-session-secret"

# 文件上传限制（MB）
# MAX_FILE_SIZE=10

# ===================================
# 生产环境安全检查清单
# ===================================
#
# [ ] 已修改 JWT_SECRET 为强随机字符串
# [ ] 已修改数据库密码（如果使用默认密码）
# [ ] 已配置正确的 CORS_ORIGIN（不使用 *）
# [ ] 已设置 NODE_ENV=production
# [ ] 已配置 HTTPS（如果有域名）
# [ ] 已设置防火墙规则
# [ ] 已配置日志收集
# [ ] 已设置数据库备份策略
